<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TailPad.Host</RootNamespace>
    <AssemblyName>TailPad</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>TailPad</Product>
    <Description>Phone gamepad for your PC over Tailscale</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <!-- Controller driver installer bundled inside the exe (downloaded by CI / scripts/get-driver.sh, BSD-3 licence) -->
  <ItemGroup Condition="Exists('Driver\ViGEmBus_Setup.exe')">
    <EmbeddedResource Include="Driver\ViGEmBus_Setup.exe" LogicalName="ViGEmBus_Setup.exe" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TailPad.Core\TailPad.Core.csproj" />
  </ItemGroup>
</Project>
